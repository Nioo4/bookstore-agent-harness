COMPOSE_PROJECT_NAME=bookstore
APP_PORT=8088
APP_BASE_URL=http://localhost:8088
COOKIE_SECURE=false
MYSQL_DATABASE=bookstore
MYSQL_ROOT_PASSWORD=replace-with-random-secret
MYSQL_BUSINESS_PASSWORD=replace-with-random-secret
MYSQL_AGENT_PASSWORD=replace-with-random-secret
# v2 upgrade prerequisite: an existing .env must define this worker-only secret.
MYSQL_WORKER_PASSWORD=replace-with-random-secret
GUEST_RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-bytes
BUILD_COMMIT=development
ENVIRONMENT=development

# DeepSeek-compatible chat gateway. The normal stack uses this provider; the
# explicit compose.e2e.yaml overlay replaces it with a local fixture.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-model-provider-key
MODEL_ADAPTER=deepseek-chat-json-v1
MODEL_PROFILE=deepseek-flash-v2
PROMPT_SET_VERSION=v4.2-single-agent-rag
AGENT_MODEL=deepseek-v4-flash
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT=30s

# Qwen embedding gateway.
EMBEDDING_BASE_URL=https://ws-bl3h1eur581tnntn.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-embedding-provider-key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT=30s
POLICY_COLLECTION_ALIAS=bookstore_policy_current
BOOK_COLLECTION_ALIAS=bookstore_book_knowledge_current
RAG_INDEX_MANIFEST_PATH=runtime/rag-index-manifest.json

# Local email verification uses Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bookstore.local
SMTP_SEND_TIMEOUT=5s
AUTH_RPC_TIMEOUT=10s
AUTH_HTTP_TIMEOUT=15s
AUTH_WEB_TIMEOUT=20s
AUTH_RESEND_IP_LIMIT=30
AUTH_RESEND_EMAIL_LIMIT=5
AUTH_RESEND_WINDOW=1h
AUTH_RESEND_COOLDOWN=60s

# Single-Agent and RAG budgets.
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_PARALLEL_READS=3
AGENT_REQUEST_TIMEOUT=120s
RAG_MAX_CONTEXT_TOKENS=6000
CONFIRMATION_TTL=10m
INVENTORY_WATCH_DEFAULT_TTL=30d
INVENTORY_WATCH_MAX_TTL=90d

# Direct MySQL Outbox worker.
LEGACY_MEMORY_COLLECTION=bookstore_memory_qwen37_1024_v1
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_TTL=30s
OUTBOX_MAX_ATTEMPTS=10

# Short-term state, retention and guest limits.
TRACE_RETENTION_DAYS=30
GUEST_CHAT_REQUESTS_PER_HOUR=20
GUEST_CHAT_MAX_CONCURRENT_PER_IP=2
GUEST_CHAT_TIMEOUT=120s

# Compose-managed service addresses. Do not put these in the root .env unless
# you intentionally override the local topology.
# BUSINESS_GRPC_ADDR=bookstore-service:9090
# AGENT_API_URL=http://agent-api:8000
# AGENT_MYSQL_DSN=mysql://bookstore_agent:CHANGE_ME@mysql:3306/bookstore
# WORKER_MYSQL_DSN=mysql://bookstore_worker:CHANGE_ME@mysql:3306/bookstore
# REDIS_ADDR=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# JWT_PRIVATE_KEY_PATH=/keys/private/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/keys/public/jwt-public.pem
# TRUSTED_PROXY_CIDRS=172.30.11.20/32

# Optional observability profile. Leave OTEL empty for the default quiet stack;
# set it explicitly to otel-collector:4317 before
# docker compose --profile observability up when export is desired.
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
