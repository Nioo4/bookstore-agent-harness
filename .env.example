COMPOSE_PROJECT_NAME=bookstore
APP_PORT=8088
APP_BASE_URL=http://localhost:8088
MYSQL_DATABASE=bookstore
MYSQL_ROOT_PASSWORD=replace-with-random-secret
MYSQL_BUSINESS_PASSWORD=replace-with-random-secret
MYSQL_AGENT_PASSWORD=replace-with-random-secret
MYSQL_PUBLISHER_PASSWORD=replace-with-random-secret
GUEST_RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-bytes
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
BUILD_COMMIT=development
ENVIRONMENT=development
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-model-provider-key
MODEL_ADAPTER=deepseek-chat-json-v1
MODEL_PROFILE=deepseek-flash-v1
PROMPT_SET_VERSION=v3-evidence-grounded
ROUTER_MODEL=deepseek-v4-flash
AGENT_MODEL=deepseek-v4-flash
VERIFIER_MODEL=deepseek-v4-flash
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT=30s
EMBEDDING_BASE_URL=https://ws-bl3h1eur581tnntn.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-embedding-provider-key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT=30s
POLICY_COLLECTION=bookstore_policy_qwen37_1024_v1
COOKIE_SECURE=false

# Mailpit is local-only. External SMTP requires explicit credentials/configuration.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bookstore.local
SMTP_SEND_TIMEOUT=5s
AUTH_RPC_TIMEOUT=10s
AUTH_HTTP_TIMEOUT=15s
AUTH_WEB_TIMEOUT=20s
AUTH_RESEND_IP_LIMIT=30
AUTH_RESEND_EMAIL_LIMIT=5
AUTH_RESEND_WINDOW=1h
AUTH_RESEND_COOLDOWN=60s

# Agent budgets, memory, events and application Trace retention.
# Manifest paths are relative to /app/agent (the read-only application root).
AGENT_MAX_NODES=12
AGENT_MAX_DEPTH=4
AGENT_MAX_PARALLEL=3
AGENT_MAX_TOOL_CALLS=20
CONFIRMATION_TTL=10m
CONFIRMATION_BINDING_TTL=24h
MEMORY_COLLECTION=bookstore_memory_qwen37_1024_v1
MEMORY_INFERRED_MIN_CONFIDENCE=0.85
INVENTORY_STREAM=inventory.events
INVENTORY_STREAM_GROUP=inventory-watch-workers
INVENTORY_STREAM_DLQ=inventory.events.dlq
INVENTORY_STREAM_BLOCK=5s
INVENTORY_STREAM_BATCH_SIZE=20
INVENTORY_STREAM_CLAIM_IDLE=60s
INVENTORY_EVENT_MAX_ATTEMPTS=10
INVENTORY_EVENT_RETENTION=7d
INVENTORY_WATCH_DEFAULT_TTL=30d
INVENTORY_WATCH_MAX_TTL=90d
INVENTORY_WATCH_EXPIRY_SCAN_INTERVAL=60s
TRACE_RETENTION_DAYS=30
TRACE_PURGE_INTERVAL=1h
TRACE_PURGE_GRACE=24h
TRACE_MAX_JSON_BYTES=65536
TRACE_MAX_FINAL_ANSWER_BYTES=32768
TRACE_MAX_ERROR_BYTES=2048
TRACE_MAX_EVIDENCE_BYTES=8192
TRACE_MAX_RUN_BYTES=2097152
TRACE_STEP_PAGE_SIZE=100
REPLAY_MAX_PER_USER_PER_HOUR=5
REPLAY_MAX_CONCURRENT_PER_USER=1
REPLAY_LEASE_TTL=60s
MODEL_PROFILE_MANIFEST_PATH=config/model-profiles.yaml
PROMPT_MANIFEST_PATH=prompts/manifest.yaml
PRICING_MANIFEST_PATH=pricing/pricing-v1.json
EVAL_RETENTION_DAYS=180
EVAL_ARTIFACT_DIR=evals/reports
LLM_JUDGE_ENABLED=false
JUDGE_MODEL_PROFILE=deepseek-pro-v1
JUDGE_PROMPT_VERSION=recommendation-v1
GUEST_CHAT_REQUESTS_PER_HOUR=20
GUEST_CHAT_MAX_CONCURRENT_PER_IP=2
GUEST_CHAT_TIMEOUT=120s

# Business Outbox publisher.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_TTL=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=5m
OUTBOX_ALERT_AFTER_ATTEMPTS=10
BUSINESS_OUTBOX_RETENTION=30d

# Compose-managed addresses/keys: edit compose.yaml and deploy/config together
# when changing topology. These are documented standalone-process variables,
# NOT root .env overrides; DSNs use separate least-privilege accounts.
# MYSQL_DSN=bookstore_business:CHANGE_ME@tcp(mysql:3306)/bookstore?parseTime=true&loc=UTC
# AGENT_MYSQL_DSN=mysql://bookstore_agent:CHANGE_ME@mysql:3306/bookstore
# OUTBOX_MYSQL_DSN=bookstore_publisher:CHANGE_ME@tcp(mysql:3306)/bookstore?parseTime=true&loc=UTC
# REDIS_ADDR=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# JWT_PRIVATE_KEY_PATH=/keys/private/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/keys/public/jwt-public.pem
# TRUSTED_PROXY_CIDRS=172.30.11.20/32
# OTEL_TRACE_RETENTION_DAYS=7 (fixed with observability/tempo/tempo.yml)
